###############################################################################
# AVE-VPC: Variables de configuracion
#
# Copia este archivo a config/env y rellena tus valores.
# NUNCA subas config/env a git (esta en .gitignore).
###############################################################################

# --- Servidor mlvpn ---
# IP o hostname del servidor (VPS de Oracle Cloud o hostname DDNS de la RPi)
# Ejemplos:
#   Oracle Cloud:  VPS_IP="203.0.113.50"
#   Raspberry Pi:  VPS_IP="tu-hostname.dedyn.io"
VPS_IP="203.0.113.50"

# Usuario SSH del servidor
VPS_USER="ubuntu"

# Puerto SSH del servidor
VPS_SSH_PORT="22"

# --- Raspberry Pi (solo si usas RPi en casa en lugar de VPS) ---
# IP local de la RPi durante el setup (buscarla en http://192.168.1.1)
# Una vez configurada, el Mac se conecta via VPS_IP (el hostname DDNS)
RPi_IP=""
RPi_USER="ubuntu"
RPi_SSH_PORT="22"

# --- mlvpn ---
# Puertos UDP que usa mlvpn en el VPS (uno por cada enlace/interfaz)
MLVPN_PORT_1="5080"
MLVPN_PORT_2="5081"
# Puerto del 3er enlace WiFi (opcional). En el servidor mlvpn se hace
# bind aquí; si la WiFi del Mac no es elegible (sin IP, red de casa,
# captive portal) se ignora silenciosamente.
MLVPN_PORT_3="5082"

# Puerto público al que CONECTA el cliente para el 3er enlace WiFi.
# Por defecto coincide con MLVPN_PORT_3 (sin mapeo de puertos). Si tu
# router hace port forwarding desde otro puerto público hacia
# MLVPN_PORT_3 internamente, pon aquí el puerto público.
#
# Caso de uso real: las redes WiFi públicas restrictivas (AVE,
# aeropuertos, hoteles) suelen filtrar puertos altos arbitrarios como
# 5082, pero dejan pasar 443/UDP (QUIC). Solución: el router de casa
# mapea WAN:443/UDP → RPi:5082 y el cliente conecta a 443. mlvpn
# server sigue escuchando en 5082, sin cambios en core.
#
# Para activarlo: descomentar y poner 443. Requiere también añadir el
# port forwarding 443/UDP → MLVPN_PORT_3 en tu router.
#MLVPN_PORT_3_REMOTE="443"

# --- Red del tunel mlvpn (v1) ---
# IP del VPS dentro del tunel mlvpn
TUN_VPS_IP="10.10.10.1"

# IP del Mac dentro del tunel mlvpn
TUN_MAC_IP="10.10.10.2"

# Mascara
TUN_NETMASK="255.255.255.0"

# --- Resolvers y endpoints externos ---
# Fallback DNS resolvers cuando el sistema falla (ej. corp con
# split-DNS, WiFi tren con DNS sucio). LISTA espacio-separada — el
# resolver prueba en orden hasta que uno responde. Lecciones reales:
#   - Roche corp bloquea 1.1.1.1 y 9.9.9.9 outbound, deja pasar 8.8.8.8.
#   - WiFi AVE puede bloquear 8.8.8.8 pero no 1.1.1.1.
# Default: Cloudflare → Google → Quad9 (cubre la mayoría de casos).
# NO HARDCODEAR en código — siempre via esta variable.
FALLBACK_DNS_RESOLVERS="1.1.1.1 8.8.8.8 9.9.9.9"

# Endpoint público estable para health-checks externos (ping, curl).
# IP literal para evitar dependencia de DNS. Default Cloudflare DNS.
HEALTH_PROBE_IP="1.1.1.1"

# Endpoint HTTP estable para verificar IP pública vía túnel y latencia
# HTTP. Cloudflare cdn-cgi/trace es ideal: cuerpo plain text con
# campos `ip=`, `loc=`, `colo=`. Path estable, sin DNS lookup.
HEALTH_PROBE_HTTP="http://1.1.1.1/cdn-cgi/trace"

# --- Red del tunel ubond (v2) ---
# Subnet DISTINTA de mlvpn (10.10.10.x) — REQ-NET-24. Si ambos
# tunnels comparten subnet en el RPi, el kernel enruta replies por
# la interfaz creada primero (mlvpn0) y el dataplane ubond no
# completa el round-trip. Documentado en
# docs/v2-ubond/04-bugs-trayecto-2026-05-29.md sección "Resolución
# Bug #5".
UBOND_TUN_VPS_IP="10.10.20.1"
UBOND_TUN_MAC_IP="10.10.20.2"

# MTU del tunel. Móvil 4G suele tener MTU 1500 hacia el ISP. mlvpn
# encapsula con UDP+IPv4 (28) + ChaCha20 nonce+tag (~32) + header
# mlvpn (~16) ≈ 76 bytes de overhead, así que 1500-76 = 1424 es el
# máximo seguro. Usamos 1400 para tener margen ante variaciones del
# camino (PMTU sobre tren, hairpin del operador, etc.). Un MTU
# demasiado alto provoca fragmentación intermitente o drops por
# black-hole de PMTUD que se traduce en lag y retransmisiones.
TUN_MTU="1400"

# --- Interfaces fisicas del Mac ---
# Ambos moviles van por cable USB con su tethering activo.
# Asi liberamos el Wi-Fi del Mac para conectarlo al Wi-Fi del AVE como
# 3er enlace opcional (IFACE_WIFI mas abajo).

# Interfaz USB del iPhone (Personal Hotspot por cable)
# DHCP del iPhone asigna IP en el rango 172.20.10.x al Mac.
# Para averiguarlo: ./00-detectar-interfaces.sh o
# networksetup -listallhardwareports tras conectar el iPhone.
# Suele ser "en8", "en9" o similar.
IFACE_IPHONE="en8"

# Interfaz USB del Pixel (tethering por USB)
# DHCP del Android asigna IP en 192.168.42.x o 192.168.43.x al Mac.
# Para averiguarlo: ./00-detectar-interfaces.sh o
# networksetup -listallhardwareports tras conectar el Pixel.
# Suele ser "en12", "en11" o similar.
IFACE_PIXEL="en12"

# Interfaz Wi-Fi nativa del Mac (3er enlace opcional)
# Casi siempre es "en0". Se usa para Wi-Fi del AVE, oficina, hoteles.
# 04-conectar.sh hace pre-flight checks: si no tiene IP, está en captive
# portal o estás en la red de casa (donde está la RPi), se ignora.
# Para forzar saltar el WiFi: ./04-conectar.sh --sin-wifi
IFACE_WIFI="en0"
