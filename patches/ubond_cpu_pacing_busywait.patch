diff --git a/src/reorder.c b/src/reorder.c
index 25598d7..b02d1d8 100644
--- a/src/reorder.c
+++ b/src/reorder.c
@@ -64,7 +64,7 @@ struct ubond_reorder_buffer {
 
   ubond_pkt_list_t list;
 
-  ev_check reorder_drain_check;
+  ev_timer reorder_drain_check;
 
 };
 static struct ubond_reorder_buffer *reorder_buffer;
@@ -111,16 +111,30 @@ double ubond_total_loss()
   return r;
 }
   
-void ubond_reorder_drain_check(EV_P_ ev_check *w, int revents)
+void ubond_reorder_drain_check(EV_P_ ev_timer *w, int revents)
 {
   struct ubond_reorder_buffer *b=reorder_buffer;
   ev_tstamp now=ev_now(EV_DEFAULT_UC);
   ev_tstamp diff=now - b->last_tick;
-  
+
   if (b->pkts_sent < b->pkts_per_sec * diff) {
     b->pkts_sent++;
     ubond_reorder_drain();
   }
+
+  // This used to be an ev_check, which runs every loop iteration without ever
+  // sleeping -> forced select(timeout=0) and pinned a CPU core at 100% the
+  // whole time the buffer was non-empty. Now it's an ev_timer: if the buffer
+  // still has packets, re-arm to sleep exactly until the next packet is due at
+  // the current pkts_per_sec rate (the budget that the `if` above gates on).
+  // ubond_reorder_drain() stops the timer when the buffer empties.
+  if (!UBOND_TAILQ_EMPTY(&b->list)) {
+    ev_tstamp wait = ((double)(b->pkts_sent + 1) / b->pkts_per_sec) - diff;
+    if (wait < 0.001) wait = 0.001;   // floor>0: ev_timer_again with repeat==0 STOPS the timer
+    if (wait > 0.25) wait = 0.25;     // never sleep past the reorder tick that resets the budget
+    w->repeat = wait;
+    ev_timer_again(EV_A_ w);
+  }
 }
 
 void ubond_reorder_tick(EV_P_ ev_timer *w, int revents)
@@ -195,7 +209,7 @@ void ubond_reorder_init()
   reorder_buffer->enabled=0;
   ubond_reorder_reset();
 
-  ev_check_init(&reorder_buffer->reorder_drain_check, ubond_reorder_drain_check);
+  ev_init(&reorder_buffer->reorder_drain_check, ubond_reorder_drain_check);
 
   ev_timer_init(&reorder_timeout_tick, &ubond_reorder_tick, 0., 0.25);
   ev_timer_start(EV_A_ &reorder_timeout_tick);
@@ -307,7 +321,8 @@ void ubond_reorder_insert(ubond_tunnel_t *tun, ubond_pkt_t *pkt)
   }
 
   if (!ev_is_active(&b->reorder_drain_check)) {
-    ev_check_start(EV_A_ &b->reorder_drain_check);
+    b->reorder_drain_check.repeat = 0.001;  // wake almost immediately to start draining
+    ev_timer_again(EV_A_ &b->reorder_drain_check);
   }
 //  ubond_reorder_drain();
 }
@@ -406,7 +421,7 @@ void ubond_reorder_drain()
 
   if (UBOND_TAILQ_EMPTY(&b->list)) {
     if (ev_is_active(&b->reorder_drain_check)) {
-      ev_check_stop(EV_A_ &b->reorder_drain_check);
+      ev_timer_stop(EV_A_ &b->reorder_drain_check);
     }
   }
 
diff --git a/src/ubond.c b/src/ubond.c
