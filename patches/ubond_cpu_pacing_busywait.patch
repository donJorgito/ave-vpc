--- a/src/ubond.c
+++ b/src/ubond.c
@@ -919,25 +919,58 @@ ubond_rtun_do_send(ubond_tunnel_t *tun)
 
   tun->idle=0;
   if ( tun->bytes_since_adjust < b ) {
-    if (! UBOND_TAILQ_EMPTY(&tun->hpsbuf)) {
-      ubond_pkt_t *pkt=UBOND_TAILQ_POP_LAST(&tun->hpsbuf);
-      len = ubond_rtun_send(tun, pkt);
-    } else {
-      ubond_rtun_choose(tun);//EV_P_ ev_timer *w, int revents);
-      if (! UBOND_TAILQ_EMPTY(&tun->sbuf)) {
-        ubond_pkt_t *pkt=UBOND_TAILQ_POP_LAST(&tun->sbuf);
+    // Drain as many packets as the byte budget allows in ONE wakeup, instead of
+    // one-packet-per-timer-fire. recalc_weight set send_timer.repeat as low as
+    // ~0.12ms at 10Mbps (DEFAULT_MTU/10 / bytes_per_sec), so the old single-shot
+    // model fired the timer at ~8kHz and pinned a CPU core. Batching decouples
+    // the timer frequency from the packet rate. bytes_since_adjust is updated
+    // below from `len`, so we re-test the budget each iteration.
+    do {
+      len = 0;
+      if (! UBOND_TAILQ_EMPTY(&tun->hpsbuf)) {
+        ubond_pkt_t *pkt=UBOND_TAILQ_POP_LAST(&tun->hpsbuf);
         len = ubond_rtun_send(tun, pkt);
       } else {
-        tun->idle=1;
+        ubond_rtun_choose(tun);
+        if (! UBOND_TAILQ_EMPTY(&tun->sbuf)) {
+          ubond_pkt_t *pkt=UBOND_TAILQ_POP_LAST(&tun->sbuf);
+          len = ubond_rtun_send(tun, pkt);
+        } else {
+          tun->idle=1;
+        }
       }
-    }
+      if (len > 0) {
+        tun->bytes_since_adjust += len + IP4_UDP_OVERHEAD;
+        tun->busy_writing++;
+        if (!ev_is_active(&tun->io_write)) ev_io_start(EV_A_ &tun->io_write);
+      }
+    } while (len > 0 && tun->bytes_since_adjust < b);
+
     if (ev_is_active(&tun->check_ev)) {
       ev_check_stop(EV_A_ &tun->check_ev);
     }
+    return;   // budget accounting handled inline above; skip single-shot tail
   } else {
-// we're too soon, use a checker to wait for the right time
-    if (!ev_is_active(&tun->check_ev)) {
-      ev_check_start(EV_A_ &tun->check_ev);
+    // We're too soon. The original code armed an ev_check here, but an active
+    // ev_check forces libev's loop into select(timeout=0) and spins a whole
+    // CPU core (confirmed via `sample`: __select 83% at 99% CPU). Instead,
+    // sleep exactly until enough byte budget has accrued: budget grows at
+    // bytes_per_sec, and we need (bytes_since_adjust - b) more bytes.
+    if (ev_is_active(&tun->check_ev)) {
+      ev_check_stop(EV_A_ &tun->check_ev);
+    }
+    if (tun->bytes_per_sec > 0) {
+      ev_tstamp wait = ((double)tun->bytes_since_adjust - b) / tun->bytes_per_sec;
+      // Floor strictly above 0: ev_timer_again with repeat==0 STOPS the timer
+      // (libev semantics), which would kill this link's send pump in idle.
+      // 5ms matches the recalc_weight floor (200Hz cap); do_send batches so
+      // this never throttles throughput, it just stops the loop spinning.
+      if (wait < 0.005) wait = 0.005;
+      // Never sleep past the next bandwidth-budget reset (BANDWIDTHCALCTIME),
+      // which zeroes bytes_since_adjust and would let us send anyway.
+      if (wait > BANDWIDTHCALCTIME) wait = BANDWIDTHCALCTIME;
+      tun->send_timer.repeat = wait;
+      ev_timer_again(EV_A_ &tun->send_timer);
     }
   }
 
