     if (t->status < UBOND_AUTHOK) {
+        /* REQ-NET-35: si llevamos UBOND_REBIND_THRESHOLD iteraciones sin
+         * trafico inbound (cliente), el pinhole NAT del carrier 4G es
+         * sospechoso de haber expirado: cerrar socket y abrir uno nuevo
