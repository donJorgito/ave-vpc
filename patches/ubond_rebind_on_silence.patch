+
+/* REQ-NET-35: cierra el socket UDP actual y libera addrinfo para que el
+ * proximo ubond_rtun_start cree uno nuevo (kernel asigna sport efimero
+ * distinto). Llamado desde check_timeout cuando el silencio inbound
+ * supera UBOND_REBIND_THRESHOLD. */
+static void
+ubond_rtun_rebind_socket_internal(ubond_tunnel_t *t)
+{
+    if (t->fd >= 0) {
+        ev_io_stop(EV_A_ &t->io_read);
+        ev_io_stop(EV_A_ &t->io_write);
+        close(t->fd);
+        t->fd = -1;
+    }
+    if (t->addrinfo) {
+        freeaddrinfo(t->addrinfo);
+        t->addrinfo = NULL;
+    }
+    /* tick_connect ejecutara ubond_rtun_start en la siguiente iteracion. */
+}
+
+/* REQ-NET-35: simbolo publico (igual que ubond_rtun_drop) por si algun
+ * futuro callsite externo lo necesita; hoy solo lo usa check_timeout. */
+void
+ubond_rtun_rebind_socket(ubond_tunnel_t *t)
+{
+    ubond_rtun_rebind_socket_internal(t);
 }
