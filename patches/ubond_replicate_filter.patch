+/* REQ-NET-12: replicación selectiva por 5-tupla */
+struct ubond_replicate_filters_s ubond_replicate_filters = {
+    .count = 0
+};
+
+/* Set LRU circular para descartar paquetes replicados duplicados en el
+ * receptor. 1024 × uint64_t = 8 KB. Búsqueda lineal O(1024) ~= 1µs. */
+#define REPLICATE_DEDUP_SIZE 1024
+static uint64_t replicate_dedup_seen[REPLICATE_DEDUP_SIZE] = {0};
+static uint16_t replicate_dedup_idx = 0;
+
+static int
+ubond_replicate_dedup_check(uint64_t data_seq)
+{
+    int i;
+    if (data_seq == 0) return 0;  /* paquetes sin reorder no se dedupean */
+    for (i = 0; i < REPLICATE_DEDUP_SIZE; i++) {
+        if (replicate_dedup_seen[i] == data_seq) return 1;
+    }
+    replicate_dedup_seen[replicate_dedup_idx] = data_seq;
+    replicate_dedup_idx = (replicate_dedup_idx + 1) % REPLICATE_DEDUP_SIZE;
+    return 0;
+}
 #endif

