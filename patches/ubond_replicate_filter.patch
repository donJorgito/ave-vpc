--- a/src/filters.c
+++ b/src/filters.c
@@ -1,6 +1,10 @@
+#include <string.h>
 #include "ubond.h"

 extern struct ubond_filters_s ubond_filters;
+/* REQ-NET-12: filtros de replicación selectiva. Definida globalmente
+ * en ubond.c igual que ubond_filters. */
+extern struct ubond_replicate_filters_s ubond_replicate_filters;

 ubond_tunnel_t *
 ubond_filters_choose(uint32_t pktlen, const u_char *pktdata) {
@@ -35,3 +39,45 @@ ubond_filters_add(const struct bpf_program *filter, ubond_tunnel_t *tun) {
     ubond_filters.count++;
     return 0;
 }
+
+/*
+ * REQ-NET-12: comprueba si un paquete matchea alguna regla de
+ * replicación. Devuelve 1 si match (paquete debe duplicarse a N
+ * túneles), 0 si no (camino normal de routing).
+ */
+int
+ubond_replicate_filter_match(uint32_t pktlen, const u_char *pktdata) {
+    int i;
+    struct pcap_pkthdr hdr;
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.caplen = pktlen;
+    hdr.len = pktlen;
+    for (i = 0; i < ubond_replicate_filters.count; i++) {
+        if (pcap_offline_filter(&ubond_replicate_filters.filter[i],
+                                &hdr, pktdata) != 0) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/*
+ * REQ-NET-12: añade una regla compilada al pool de replicación.
+ * El `name` es solo informativo (logs); no se usa para lookup.
+ */
+int
+ubond_replicate_filter_add(const struct bpf_program *filter, const char *name) {
+    if (ubond_replicate_filters.count >= 255) {
+        return -1;
+    }
+    memcpy(&ubond_replicate_filters.filter[ubond_replicate_filters.count],
+           filter, sizeof(*filter));
+    if (name) {
+        strncpy(ubond_replicate_filters.name[ubond_replicate_filters.count],
+                name, UBOND_REPLICATE_NAME_MAX - 1);
+        ubond_replicate_filters.name[ubond_replicate_filters.count]
+                                    [UBOND_REPLICATE_NAME_MAX - 1] = '\0';
+    }
+    ubond_replicate_filters.count++;
+    return 0;
+}
