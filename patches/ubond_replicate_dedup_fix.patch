@@ -1863,11 +1884,23 @@
       if (ubond_pkt_list_is_full(&t->hpsbuf)) continue;

       ubond_pkt_t *clone = ubond_pkt_get();
+      /* REQ-NET-27: defensive — pool exhausto puede devolver NULL
+       * (ubond_pkt_get hace malloc en fallback, que también puede
