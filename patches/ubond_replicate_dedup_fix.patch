+       * para que TODOS los clones compartan el mismo data_seq y la
+       * dedup LRU del receptor pueda matchear. NO sobreescribir aquí
+       * con el global, que ya avanzó tras el clone anterior. */
+      if (pkt->replicated) {
+        /* mantener proto->data_seq tal como vino del clone */
+      } else if (pkt->p.reorder) {
         proto->data_seq = data_seq;
       } else {
         proto->data_seq = 0;
@@ -810,7 +827,11 @@
       // we are here when we succeed to send the packet

       if (pkt->p.type!=UBOND_PKT_DATA_RESEND) {
-        if (pkt->p.reorder) data_seq++;
+        /* REQ-NET-27: data_seq global SOLO avanza una vez por paquete
