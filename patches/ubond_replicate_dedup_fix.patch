-        return 0;
+        /* REQ-NET-27: contrato del retorno actualizado:
+         *   < 0  = error de protocolo (parsing, crypto, etc).
+         *   = 0  = paquete válido, caller continúa procesando.
+         *   > 0  = paquete consumido internamente (dedup hit), caller
+         *          NO debe continuar (sino se contabiliza como pérdida
+         *          en reorder y dispara request_resend espurio). */
+        return 1;
     }
 #endif
     if (proto->timestamp != (uint16_t)-1) {
@@ -695,7 +705,14 @@
     set_reorder(pkt);

     if (pkt->p.type!=UBOND_PKT_DATA_RESEND) {
-      if (pkt->p.reorder) {
+      /* REQ-NET-27: si el paquete viene de replicate (clone), su
