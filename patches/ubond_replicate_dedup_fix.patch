--- a/src/pkt.h
+++ b/src/pkt.h
@@ -38,6 +38,11 @@
   ubond_proto_t p;
   ev_tstamp timestamp;
   uint16_t len; // wire read length
+  /* REQ-NET-27: marca paquetes clonados por replicate filter (REQ-NET-12).
+   * Si =1, ubond_rtun_send NO debe sobreescribir p.data_seq (ya viene
+   * asignado en ubond_rtun_choose) NI incrementar el global data_seq
+   * en el send-success. Cero significa paquete normal. NO va al wire. */
+  int replicated;
   TAILQ_ENTRY(ubond_pkt_t) entry;
 } ubond_pkt_t;

--- a/src/ubond.c
+++ b/src/ubond.c
@@ -456,8 +456,12 @@
     } else {
         pkt->len=len; // stamp the wire length

-        /* validate the received packet */
-        if (ubond_protocol_read(tun, pkt) < 0) {
+        /* validate the received packet — REQ-NET-27 contract:
+         *   < 0 = error → liberar y volver
+         *   > 0 = consumido internamente (dedup hit) → liberar y volver
+         *   = 0 = válido, seguir procesando */
+        int pr = ubond_protocol_read(tun, pkt);
+        if (pr != 0) {
           ubond_pkt_release(pkt);
           return;
         }
@@ -649,7 +653,13 @@
         ubond_replicate_dedup_check(proto->data_seq)) {
         log_debug("replicate", "%s descartando duplicado data_seq=%lu",
