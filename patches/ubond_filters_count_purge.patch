 int ubond_replicate_filter_add(const struct bpf_program *filter, const char *name);
 int ubond_replicate_filter_match(uint32_t pktlen, const u_char *pktdata);
+/* REQ-NET-36: purga el pool de replicación antes de re-añadir en SIGHUP. */
