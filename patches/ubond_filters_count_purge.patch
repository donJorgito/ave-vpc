diff --git a/src/filters.c b/src/filters.c
--- a/src/filters.c
+++ b/src/filters.c
@@ -81,3 +81,23 @@ ubond_replicate_filter_add(const struct bpf_program *filter, const char *name) {
     ubond_replicate_filters.count++;
     return 0;
 }
+
+/*
+ * REQ-NET-36: libera los bpf_program compilados del pool de
+ * replicación y resetea count a 0. Necesario antes de re-añadir
+ * filtros en SIGHUP / config reload — sin esto, cada reload
+ * exitoso DUPLICA los filtros previos en el array (memory leak +
+ * doble match en ubond_replicate_filter_match). Bug colateral
+ * descubierto durante DNS-investigation 2026-06-08.
+ */
+void
+ubond_replicate_filters_clear(void) {
+    int i;
+    for (i = 0; i < ubond_replicate_filters.count; i++) {
+        pcap_freecode(&ubond_replicate_filters.filter[i]);
+        memset(&ubond_replicate_filters.filter[i], 0,
+               sizeof(ubond_replicate_filters.filter[i]));
+        ubond_replicate_filters.name[i][0] = '\0';
+    }
+    ubond_replicate_filters.count = 0;
+}
